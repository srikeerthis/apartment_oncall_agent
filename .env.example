# --- MeetStream (your part — fill these in now) ---------------------------
# app.meetstream.ai/api-keys
MEETSTREAM_API_KEY=

# Public URL your local bridge server is reachable at (ngrok, while testing).
# MeetStream POSTs live transcript chunks + speaker labels here.
# Example: https://abcd1234.ngrok-free.app/meetstream/webhook
WEBHOOK_URL=

# Public URL MeetStream POSTs bot status events to (joining / in lobby / admitted / left).
# Example: https://abcd1234.ngrok-free.app/meetstream/callback
CALLBACK_URL=

# Google Meet link to test with (meet.google.com/xxx-xxxx-xxx)
MEETING_LINK=

# Local port the bridge server (uvicorn) listens on
PORT=8000

# --- Scalekit (partner's part) ---------------------------------------------
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=
SCALEKIT_ENV_URL=https://yourorg.scalekit.com
SCALEKIT_MCP_CONFIG_ID=cfg_...

# --- Airtable (partner's part) ----------------------------------------------
AIRTABLE_BASE_ID=
AIRTABLE_CONNECTION_NAME=
