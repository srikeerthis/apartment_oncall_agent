# --- MeetStream (your part — fill these in now) ---------------------------
# app.meetstream.ai/api-keys
MEETSTREAM_API_KEY=

# Public URL your local bridge server is reachable at (ngrok, while testing).
# MeetStream POSTs live transcript chunks + speaker labels here.
# Example: https://abcd1234.ngrok-free.app/meetstream/webhook
WEBHOOK_URL=

# Public URL MeetStream POSTs bot status events to (joining / in lobby / admitted / left).
# Example: https://abcd1234.ngrok-free.app/meetstream/callback
CALLBACK_URL=

# Google Meet link to test with (meet.google.com/xxx-xxxx-xxx)
MEETING_LINK=

# Local port the bridge server (uvicorn) listens on
PORT=8000

# Transcription source, read by agent/create_bot.py:
#   meeting_captions      platform captions, no extra key, but fragmentary --
#                         no reliable end-of-utterance signal for triggers
#   deepgram_streaming    clean end_of_turn events; needs a Deepgram key pasted
#                         into the MeetStream dashboard (not sent in our payload)
#   assemblyai_streaming / jigsawstack / sarvam / meetstream
STREAMING_PROVIDER=meeting_captions

# Powers MIA's voice/brain (TTS + agent LLM) in the MeetStream dashboard.
# Must ALSO be pasted into the MeetStream dashboard (Settings) — MeetStream
# calls OpenAI itself, this key isn't sent through our API payload. Without
# this configured on MeetStream's side, send_message lands as text, not speech.
OPENAI_API_KEY=

# --- Scalekit -- from your dashboard ----------------------------------------
SCALEKIT_ENVIRONMENT_URL=https://<yourorg>.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=...

# Printed by setup_vmcp.py
SCALEKIT_MCP_CONFIG_ID=cfg_...

# Optional: "mcp" (default) routes via the Virtual MCP Server, "direct" bypasses it
# SCALEKIT_TOOL_PATH=mcp

# --- Airtable ----------------------------------------------------------------
AIRTABLE_BASE_ID=app...
# SETUP ONLY -- never used at runtime. Needs schema.bases:read/write and
# data.records:read/write, plus the base added under the token's Access section.
AIRTABLE_PAT=pat...
